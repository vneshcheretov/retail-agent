# --- LLM provider -----------------------------------------------------------
# Switch the whole agent between providers without touching code.
# Supported: openai | google_genai | openrouter
LLM_PROVIDER=

# Model id for the chosen provider, e.g.
#   openai       -> gpt-5.4-mini
#   google_genai -> gemini-2.5-flash
#   openrouter   -> openai/gpt-5.4-mini
LLM_MODEL=

# API keys (set the one matching LLM_PROVIDER)
OPENAI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# --- BigQuery ---------------------------------------------------------------
# GCP project used for billing the queries (the dataset itself is public).
# Auth via Application Default Credentials:
#   gcloud auth application-default login
GCP_PROJECT=

# --- Observability (optional) -----------------------------------------------
# If you have a LangSmith account, traces are sent automatically.
# Leave empty to rely on local JSONL logs only.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=retail-data-agent
